      "apply": {
        "model": "hbm:block/pipe_anchor_south"
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "hbm:block/pipe_anchor_west"
      }
    },
    {
      "when": {
        "facing": "east"
