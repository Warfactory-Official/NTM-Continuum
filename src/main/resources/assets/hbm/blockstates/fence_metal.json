{
  "multipart": [
    {
      "when": {
        "OR": [
          {
            "north": "true",
            "south": "false"
          },
          {
            "north": "false",
            "south": "true"
          },
          {
            "west": "true",
            "east": "false"
          },
          {
            "west": "false",
            "east": "true"
          },
          {
            "north": "false",
            "south": "false",
            "west": "false",
            "east": "false"
          },
          {
            "north": "true",
            "south": "true",
            "west": "true",
            "east": "true"
          }
        ]
      },
      "apply": {
        "model": "hbm:block/fence_metal_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "hbm:block/fence_metal_side",
        "uvlock": true
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "hbm:block/fence_metal_side",
        "y": 90,
        "uvlock": true
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "hbm:block/fence_metal_side",
        "y": 180,
        "uvlock": true
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "hbm:block/fence_metal_side",
        "y": 270,
        "uvlock": true
      }
    }
  ]
}
