{
  "model": {
    "type": "minecraft:select",
    "property": "hbm:item_variant",
    "cases": [
      {"when": "0", "model": {"type": "minecraft:model", "model": "hbm:block/lightstone_unrefined"}},
      {"when": "1", "model": {"type": "minecraft:model", "model": "hbm:block/lightstone_tile"}},
      {"when": "2", "model": {"type": "minecraft:model", "model": "hbm:block/lightstone_bricks"}},
      {"when": "3", "model": {"type": "minecraft:model", "model": "hbm:block/lightstone_bricks_chiseled"}},
      {"when": "4", "model": {"type": "minecraft:model", "model": "hbm:block/lightstone_chiseled"}}
    ],
    "fallback": {"type": "minecraft:model", "model": "hbm:block/lightstone_unrefined"}
  }
}
