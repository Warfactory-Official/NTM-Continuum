{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description} ${mod_credits}",
    "authors": [
        "${mod_author}"
    ],
    "license": "${mod_license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.hbm.platform.fabric.FabricInit"
        ],
        "client": [
            "com.hbm.platform.fabric.FabricClientInit"
        ],
        "jei_mod_plugin": [
            "com.hbm.handler.jei.HbmJeiPluginFabric"
        ],
        "fabric-gametest": [
            "com.hbm.platform.fabric.FabricGameTests"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader}",
        "fabric-api": "*",
        "golemcore": "*",
        "minecraft": "${minecraft_range}",
        "java": ">=${java_version}"
    }
}
